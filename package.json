{
  "name": "threedeegame",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && npm run typecheck && esbuild src/main.ts --bundle --format=esm --outfile=dist/main.js && node build-html.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "start": "tsx server.ts",
    "serve:dist": "python3 -m http.server 3000 --directory dist"
  },
  "dependencies": {
    "littlejsengine": "1.18.29",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/three": "^0.186.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
